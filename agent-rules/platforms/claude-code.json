{
  "permissions": {
    "deny": [
      "AskUserQuestion",
      "mcp__ccd_turn__wrap_up"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "<node> <pinned>/agent-rules/hooks/steering-changed.mjs",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "<node> <pinned>/agent-rules/hooks/skill-protocol.mjs",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "<node> <pinned>/agent-rules/hooks/steering-changed.mjs",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "<python3> -I <pinned>/agent-rules/hooks/no-host-paths.py",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Skill|Agent|Bash|Edit|Read",
        "hooks": [
          {
            "type": "command",
            "command": "<node> <pinned>/agent-rules/hooks/skill-protocol.mjs",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "PYTHONPATH=<pinned>/agent-rules/hooks <python3> -B -m grill_round_check",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
