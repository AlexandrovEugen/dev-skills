{
  "permissions": {
    "deny": [
      "AskUserQuestion",
      "mcp__ccd_turn__wrap_up"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "<node> <dev-skills>/agent-rules/hooks/steering-changed.mjs", "timeout": 10 }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": "<node> <dev-skills>/agent-rules/hooks/skill-protocol.mjs", "timeout": 10 }
        ]
      },
      {
        "hooks": [
          { "type": "command", "command": "<node> <dev-skills>/agent-rules/hooks/steering-changed.mjs", "timeout": 10 }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          { "type": "command", "command": "<python3> -I <dev-skills>/agent-rules/hooks/no-host-paths.py", "timeout": 10 }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Skill",
        "hooks": [
          { "type": "command", "command": "<node> <dev-skills>/agent-rules/hooks/skill-protocol.mjs", "timeout": 10 }
        ]
      }
    ]
  }
}
